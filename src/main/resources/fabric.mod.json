{
  "schemaVersion": 1,
  "id": "pets-and-pals",
  "version": "${version}",
  "name": "Pets&Pals",
  "accessWidener": "pets-and-pals.accesswidener",
  "description": "Client-side pets with real presence. Any vanilla mob, any server.",
  "authors": [
    "aaronateataco",
    "The Pets Team (original Pets Mod)",
    "downloadableduck (original Pets Mod)"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/pets-and-pals",
    "sources": "https://github.com/aaronateataco/pets-and-pals",
    "issues": "https://github.com/aaronateataco/pets-and-pals/issues"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/pets-and-pals/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "io.github.aaronateataco.petsandpals.PetsInitializer"
    ],
    "client": [
      "io.github.aaronateataco.petsandpals.PetsClientInitializer",
      "io.github.aaronateataco.petsandpals.Central"
    ],
    "modmenu": [
      "io.github.aaronateataco.petsandpals.PetsConfigScreen"
    ]
  },
  "mixins": [
    "pets-and-pals.mixins.json",
    {
      "config": "pets-and-pals.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18",
    "minecraft": ">=26.3-",
    "java": ">=25",
    "cloth-config": "*",
    "fabric-api": "*",
    "yet_another_config_lib_v3": "*",
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/pets-and-pals"
      }
    }
  }
}